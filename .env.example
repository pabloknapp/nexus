# Database Config
POSTGRES_USER="db_user_here"
POSTGRES_PASSWORD="db_password_here"
POSTGRES_DB="db_name_here"

# URL para rodar o prisma localmente no host
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public"

# Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_key_here
CLERK_SECRET_KEY=sk_test_key_here